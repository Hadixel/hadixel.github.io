{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_API_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^generate", "^build"],
      "env": ["TEST_DATABASE_URL"]
    },
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@kmodern/api#build": {
      "dependsOn": ["generate"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "prisma/schema.prisma",
        "tsconfig.build.json",
        "nest-cli.json",
        "../../packages/contracts/src/**",
        "../../scripts/gateway-dist-manifest.mjs"
      ],
      "env": ["NODE_ENV"]
    },

    // The `//#` prefix is what makes these root tasks. Without it turbo looks for a `lint` script in
    // every workspace, finds none, and reports "no tasks were executed" while appearing to have run —
    // which is the failure mode of a linter nothing invokes. There is one root eslint config and one
    // audit script and each reads the whole tree, so each belongs to the root and to nowhere else.
    //
    // No `dependsOn`. Both read source rather than build output, and making them wait on every
    // workspace's build would mean a lint of a one-line change took as long as a full build.
    "//#lint": {
      "outputs": []
    },
    "//#audit": {
      "outputs": [],
      // The audit boots a disposable database, starts a server and reads the git history. None of
      // that is a function of the source, so a cached "pass" would be a claim about the past.
      "cache": false
    }
  },

  // Which workspace may depend on which, checked by `turbo boundaries`.
  //
  // turbo takes a package's tags from that package's own turbo.json (`"tags": ["app"]`), and the
  // rules below are keyed by tag, so a rank is declared once per package and enforced once per rank.
  // Nothing here is a prose declaration that can drift: the command fails if an edge the rules do not
  // allow exists, and it fails if an import names a package the importer did not declare — which is
  // how a hoisted node_modules otherwise hides a dependency nobody owns.
  //
  // The ranks are §4's: the kernel sits on nothing, a package sits on the kernel, an app sits on
  // packages and on nothing else. `app.dependents` is empty because §5.1 gives an app no exports
  // field — nothing imports an app — and a cycle needs two edges, so both directions are named.
  "boundaries": {
    // `vitest` is imported by every workspace's tests and declared once, at the root, because a test
    // runner is one tool for one repo (§6). Listed rather than repeated in nine manifests so the
    // version cannot drift, and so the "did you declare what you import" check stays useful instead
    // of printing the same 67 lines on every run.
    "implicitDependencies": ["vitest"],
    "tags": {
      "kernel": {
        "dependencies": { "allow": [] },
        "dependents": { "allow": ["kernel", "pkg", "app", "build-only"] }
      },
      "pkg": {
        "dependencies": { "allow": ["kernel"] },
        "dependents": { "allow": ["kernel", "pkg", "app"] }
      },
      "app": {
        "dependencies": { "allow": ["kernel", "pkg"] },
        "dependents": { "allow": [] }
      },
      "build-only": {
        "dependencies": { "allow": [] },
        "dependents": { "allow": [] }
      }
    }
  }
}
