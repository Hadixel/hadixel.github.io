{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^generate", "^build"],
      "env": ["TEST_DATABASE_URL"]
    },
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
