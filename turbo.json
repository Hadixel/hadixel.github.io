{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^generate", "^build"],
      "env": ["TEST_DATABASE_URL"]
    },
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@kmodern/api#build": {
      "dependsOn": ["generate"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "prisma/schema.prisma",
        "tsconfig.build.json",
        "nest-cli.json",
        "../../packages/schema/src/**",
        "../../scripts/gateway-dist-manifest.mjs"
      ],
      "env": ["NODE_ENV"]
    }
  }
}
