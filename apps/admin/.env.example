# Variables the admin panel reads. See the repository root .env.example for the full list
# and the tier each variable belongs to.
# REQUIRED. The gateway's base URL, inlined at build. This app no longer reads the
# repository root .env (see next.config.ts), so nothing else supplies it: unset,
# gatewayBaseUrl() returns an empty string and every read fails as "gateway not
# configured" — which surfaces as a 500 on the login page itself, so the whole
# panel is unusable and no retry helps. Restart `next dev` after changing it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3102

# Development only. Extra origins allowed to load the panel in `next dev`. The default
# covers localhost; set this to reach the panel from a device on the LAN.
ADMIN_DEV_ORIGIN=localhost

# Where the scraper writes its output, when it is not the default packages/scraper/out.
SCRAPER_PACKAGE_DIR=
# Where scraped product images are served from locally, when not the default.
SCRAPER_STORE_PUBLIC_DIR=
