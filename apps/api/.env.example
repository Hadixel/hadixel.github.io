# Variables the data tier reads. See the repository root .env.example for the full list
# and the tier each variable belongs to.

# Read at runtime, never at build. The one process that owns the database is the only
# thing that should ever see this.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# DESTRUCTIVE — the connection the test suite truncates. It must never be DATABASE_URL.
# The suite refuses to start unless the value names the disposable database that
# `scripts/test-db.sh` boots, and it points the runtime client at this value itself, so
# DATABASE_URL above is not used while the suite runs.
#   scripts/test-db.sh start   # boot it and apply every migration
#   scripts/test-db.sh stop    # shut it down
TEST_DATABASE_URL=postgresql://USER@127.0.0.1:5433/kmodern_test

# Read by prisma.config.ts for migrations as well as generate.
#   pnpm db:bootstrap -> creates the first admin user and forces a password change.
ADMIN_EMAIL=
ADMIN_PASSWORD=
