# Variables the data tier reads. See the repository root .env.example for the full list
# and the tier each variable belongs to.

# The port the gateway's HTTP server binds. 3100 is the storefront and 3101 the admin panel, so
# this is the only one of the three left; it is declared here rather than in code because the
# composition root does not exist yet (ticket 07), and a port picked when the server is written is
# a port that was never checked against the other two.
PORT=3102

# Which mode the gateway is in. "production" is the only value that turns off the /docs routes and
# stops error messages naming internals; anything else is rejected at boot rather than defaulted, so
# a typo cannot silently leave the documentation routes open.
NODE_ENV=development

# Origins allowed to call the gateway, comma separated. Never a wildcard: the gateway carries
# session credentials, and a wildcard lets any site a shopper visits make authenticated requests on
# their behalf. 3100 is the storefront and 3101 the admin panel.
CORS_ORIGINS=http://localhost:3100,http://localhost:3101

# Read at runtime, never at build. The one process that owns the database is the only
# thing that should ever see this.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# The drift check replays every migration onto an empty database and diffs the result against the
# schema, so it needs somewhere to replay onto that is not the database it is checking. It is
# created and dropped by scripts/check-migrations.sh on the disposable cluster below; leaving it
# unset makes the drift check fail rather than silently diff a database against itself.
SHADOW_DATABASE_URL=postgresql://USER@127.0.0.1:5433/kmodern_shadow

# DESTRUCTIVE — the connection the test suite truncates. It must never be DATABASE_URL.
# The suite refuses to start unless the value names the disposable database that
# `scripts/test-db.sh` boots, and it points the runtime client at this value itself, so
# DATABASE_URL above is not used while the suite runs.
#   scripts/test-db.sh start   # boot it and apply every migration
#   scripts/test-db.sh stop    # shut it down
TEST_DATABASE_URL=postgresql://USER@127.0.0.1:5433/kmodern_test

# Read by prisma.config.ts for migrations as well as generate.
#   pnpm db:bootstrap -> creates the first admin user and forces a password change.
ADMIN_EMAIL=
ADMIN_PASSWORD=
