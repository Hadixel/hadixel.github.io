// ============================================================
// kmodern — production schema (assembled from tracker tickets
// 001..019; see tracker/MAP.md for the decision trail).
// Tickets: 004 product, 005 page-builder, 006 nav, 007 blog,
// 008 component catalog, 009 orders/accounts/inventory,
// 010 admin auth, 011 checkout/payment, 014 SEO, 016 notif,
// 018 discounts. 013 migration + 012 deployment are process.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FulfillmentStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  AWAITING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  ONLINE
  CARD_TO_CARD
  COD
}

enum ShippingMethod {
  LOCAL
  POST
  BARBERI
}

enum DeliveryFeeMode {
  FREE
  FLAT
  API_QUOTE
  FALLBACK_FLAT
  FREIGHT_COLLECT
}

enum OrderEventDimension {
  FULFILLMENT
  PAYMENT
}

enum AdminRole {
  OWNER
  EDITOR
  ORDER_MANAGER
}

enum MenuLocation {
  HEADER
  FOOTER
  MOBILE
}

enum MenuDisplay {
  DROPDOWN
  MEGA
}

enum ChildSource {
  STATIC
  CATEGORY
}

enum PageKind {
  SYSTEM
  CUSTOM
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

enum DiscountScope {
  ALL
  PRODUCTS
  CATEGORIES
  COLLECTIONS
}

enum DiscountMode {
  COUPON
  AUTOMATIC
}

enum DiscountStatus {
  ACTIVE
  DISABLED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

// ------------------------------------------------------------
// Catalog (004)
// ------------------------------------------------------------

model Category {
  id         String              @id @default(cuid())
  parentId   String?
  name       String
  slug       String              @unique
  sortOrder  Int                 @default(0)
  weightKg   Float // required per 011 amendment; > 0 enforced in app
  seo        Json? // 014 optional override
  children   Category[]          @relation("CategoryTree")
  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  specFields CategorySpecField[]
  products   Product[]

  @@index([parentId])
  @@index([name])
  @@index([slug])
}

model CategorySpecField {
  id         String             @id @default(cuid())
  categoryId String
  name       String
  type       String // string | number | boolean | enum
  unit       String?
  filterable Boolean            @default(true)
  sortOrder  Int                @default(0)
  category   Category           @relation(fields: [categoryId], references: [id])
  values     ProductSpecValue[]

  @@unique([categoryId, name])
}

model Product {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  brand           String
  model           String // plain searchable field, e.g. "203"
  categoryId      String
  description     String?
  features        String[]
  extraSpecs      Json? // free-form label/value extras
  status          ProductStatus      @default(DRAFT)
  allowBackorder  Boolean            @default(false)
  seo             Json? // 014
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  category        Category           @relation(fields: [categoryId], references: [id])
  variants        Variant[]
  specValues      ProductSpecValue[]
  collectionItems CollectionItem[]
  orderItems      OrderItem[]

  @@index([status])
  @@index([categoryId])
  @@index([model])
}

model Variant {
  id             String             @id @default(cuid())
  productId      String
  colorName      String
  colorCode      String?
  sku            String             @unique
  price          Float // TOMAN
  stock          Int                @default(0)
  reserved       Int                @default(0) // 009 reserve-on-order
  allowBackorder Boolean            @default(false)
  images         String[] // ordered image urls
  seo            Json? // 014 per-variant override
  product        Product            @relation(fields: [productId], references: [id])
  orderItems     OrderItem[]
  reservations   StockReservation[]

  @@index([productId])
  @@index([sku])
}

model ProductSpecValue {
  productId   String
  specFieldId String
  value       String
  product     Product           @relation(fields: [productId], references: [id])
  specField   CategorySpecField @relation(fields: [specFieldId], references: [id])

  @@id([productId, specFieldId])
}

model Collection {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  sortOrder Int              @default(0)
  items     CollectionItem[]
}

model CollectionItem {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])

  @@id([collectionId, productId])
}

// ------------------------------------------------------------
// Customers, addresses (009)
// ------------------------------------------------------------

model Customer {
  id                  String            @id @default(cuid())
  phone               String            @unique // normalized Iranian mobile
  name                String?
  email               String? // storage-only this build (016)
  passwordHash        String? // optional, OTP-primary
  smsMarketingConsent Boolean           @default(false) // 016, never pre-ticked
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  addresses           Address[]
  orders              Order[]
  notifications       NotificationLog[]
  sessions            CustomerSession[]
}

model Address {
  id             String   @id @default(cuid())
  customerId     String
  recipientName  String
  recipientPhone String
  province       String
  city           String
  addressLine    String
  postalCode     String // 10 digits
  isDefault      Boolean  @default(false)
  label          String?
  customer       Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  issuedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([expiresAt])
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String    @default("LOGIN") // LOGIN | PLACE_ORDER
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, purpose])
}

// ------------------------------------------------------------
// Orders (009 + 011 + 018)
// ------------------------------------------------------------

model Order {
  id                String             @id @default(cuid())
  orderNumber       String             @unique // "1404-000123"
  customerId        String
  shippingAddress   Json // snapshot of Address at place
  fulfillmentStatus FulfillmentStatus  @default(PENDING)
  paymentStatus     PaymentStatus      @default(AWAITING)
  paymentMethod     PaymentMethod
  shippingMethod    ShippingMethod
  deliveryFeeMode   DeliveryFeeMode
  subtotal          Float // merchandise before discount
  discountAmount    Float              @default(0) // 018
  appliedDiscounts  Json? // snapshot of discount definitions applied (018)
  deliveryFee       Float              @default(0)
  total             Float // subtotal - discount + delivery; frozen at place
  currency          String             @default("TOMAN")
  paymentExpiresAt  DateTime? // hold window per method (011)
  gatewayAuthority  String? // Zarinpal
  gatewayRefId      String?
  shippingTracking  String? // POST tracking / BARBERI billet / LOCAL driver
  shippingMeta      Json? // billet no, driver name, etc.
  receiptImageIds   String[] // C2C uploads
  adminNote         String?
  placedAt          DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  customer          Customer           @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  events            OrderStatusEvent[]
  reservations      StockReservation[]

  @@index([customerId])
  @@index([fulfillmentStatus])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([orderNumber])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  colorName   String?
  sku         String
  unitPrice   Float
  quantity    Int
  lineTotal   Float
  image       String?
  order       Order    @relation(fields: [orderId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
  variant     Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderStatusEvent {
  id        String              @id @default(cuid())
  orderId   String
  dimension OrderEventDimension
  from      String
  to        String
  actor     String // admin user email / "SYSTEM" / "CUSTOMER"
  note      String?
  at        DateTime            @default(now())
  order     Order               @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([at])
}

model StockReservation {
  id        String            @id @default(cuid())
  orderId   String
  variantId String
  qty       Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  order     Order             @relation(fields: [orderId], references: [id])
  variant   Variant           @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@index([expiresAt])
}

model OrderNumberCounter {
  id         Int @id @default(autoincrement())
  jalaliYear Int @unique
  lastNumber Int @default(0)
}

// ------------------------------------------------------------
// Admin realm (010)
// ------------------------------------------------------------

model AdminUser {
  id                 String          @id @default(cuid())
  email              String          @unique
  passwordHash       String
  name               String
  role               AdminRole       @default(OWNER)
  isActive           Boolean         @default(true)
  totpSecret         String? // TOTP-ready, unused this build
  totpEnabledAt      DateTime?
  recoveryCodes      String[]
  lastLoginAt        DateTime?
  failedAttempts     Int             @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sessions           AdminSession[]
  auditLogs          AdminAuditLog[]
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  ip          String?
  userAgent   String?
  issuedAt    DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String?
  entityId    String?
  ip          String?
  userAgent   String?
  meta        Json?
  at          DateTime   @default(now())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([at])
}

// ------------------------------------------------------------
// Content: pages (005), navigation (006), blog (007)
// ------------------------------------------------------------

model Page {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  kind            PageKind   @default(CUSTOM)
  status          PageStatus @default(DRAFT)
  draftBlocks     Json // ordered block list [{id,type,props,visible,mobileVisible,...}]
  publishedBlocks Json
  seo             Json? // 014
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Menu {
  id       String       @id @default(cuid())
  location MenuLocation @unique
  name     String
  items    MenuItem[]
}

model MenuItem {
  id            String      @id @default(cuid())
  menuId        String
  parentId      String?
  sortOrder     Int         @default(0)
  label         String
  // LinkRef: {type, targetId?, url?, newTab?}
  target        Json
  childSource   ChildSource @default(STATIC)
  categoryId    String? // for childSource=CATEGORY (auto-list node children)
  display       MenuDisplay @default(DROPDOWN)
  visible       Boolean     @default(true)
  mobileVisible Boolean     @default(true)
  menu          Menu        @relation(fields: [menuId], references: [id])
  parent        MenuItem?   @relation("MenuTree", fields: [parentId], references: [id])
  children      MenuItem[]  @relation("MenuTree")
  promos        MenuPromo[]

  @@index([menuId])
  @@index([parentId])
}

model MenuPromo {
  id            String   @id @default(cuid())
  menuItemId    String
  sortOrder     Int      @default(0)
  imageUrl      String
  alt           String
  link          Json // LinkRef
  heading       String?
  subtext       String?
  mobileVisible Boolean  @default(false) // promo media hidden on mobile (006)
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([menuItemId])
}

model Post {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  excerpt         String?
  coverImage      String?
  body            Json // TipTap-style rich text document with embed nodes (007)
  byline          String?
  status          PostStatus @default(DRAFT)
  publishAt       DateTime?
  featured        Boolean    @default(false)
  commentsEnabled Boolean    @default(true) // hook only, no comment system
  seo             Json? // 014
  searchText      String? // maintained plaintext for ILIKE search
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  tags            PostTag[]
}

model BlogTag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  posts     PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post    @relation(fields: [postId], references: [id])
  tag    BlogTag @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
}

// ------------------------------------------------------------
// Marketing (018)
// ------------------------------------------------------------

model Discount {
  id                 String         @id @default(cuid())
  type               DiscountType
  scope              DiscountScope
  mode               DiscountMode
  code               String? // COUPON only, unique nullable
  value              Float // percent or TOMAN amount
  maxAmount          Float? // PERCENT optional cap
  productIds         String[]
  categoryIds        String[] // incl. descendants at apply time
  collectionIds      String[]
  startsAt           DateTime
  endsAt             DateTime?
  minOrderSubtotal   Float?
  maxUsesTotal       Int?
  maxUsesPerCustomer Int?
  status             DiscountStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([code])
  @@index([status])
  @@index([startsAt])
}

// ------------------------------------------------------------
// Notifications (016)
// ------------------------------------------------------------

model NotificationLog {
  id                String             @id @default(cuid())
  customerId        String?
  phone             String
  template          String // otp | orderplaced | orderpaid | ...
  orderId           String?
  status            NotificationStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  at                DateTime           @default(now())
  customer          Customer?          @relation(fields: [customerId], references: [id])

  @@index([phone])
  @@index([status])
  @@index([orderId])
}

// ------------------------------------------------------------
// Settings (011, 017, 016) + slug redirects (014)
// ------------------------------------------------------------

model Setting {
  key         String   @id // e.g. shipping.localFeeMode, store.name
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model Redirect {
  id         String   @id @default(cuid())
  from       String   @unique
  to         String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())

  @@index([from])
}

// ------------------------------------------------------------
// Price watch (026) — a recurring comparison of the Datees Shop
// catalogue against our own variants.
// ------------------------------------------------------------

/// How often the watch runs.
enum PriceWatchMode {
  INTERVAL // every `intervalMinutes`, counted from the last finished run
  DAILY // once a day, at `dailyAt` Tehran wall-clock
}

enum PriceWatchRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Who asked for the run. A schedule and an operator pressing the button are the same check
/// recorded differently, because "it ran at three and found nothing" and "an operator checked and
/// found nothing" answer different questions when someone asks why a change is in the list.
enum PriceWatchTrigger {
  SCHEDULE
  MANUAL
}

enum PriceChangeStatus {
  PENDING // recorded, not applied — the only state a detected difference may hold
  APPLIED
  IGNORED
}

/// The watch's configuration, and there is one of it.
///
/// A single row under a fixed id rather than a `Setting` key: `Setting` is a free-form key/value
/// store that every other feature is free to invent keys in, and a schedule is typed columns. A
/// `mode` read out of a JSON blob has no bounds the database enforces, so "every hour" and "every
/// hundred hours" are equally storable and only the code that reads it knows which it meant.
///
/// The id is a constant, not `cuid()`, and that is the load-bearing part: the row is created by
/// `upsert` on that constant, so two gateway processes starting at once cannot produce two
/// configurations. A `cuid()` default would make "there is only one" a fact the schema cannot
/// express, enforced only by whichever caller checked first.
model PriceWatch {
  id              String          @id // the singleton constant, see PRICE_WATCH_ID
  enabled         Boolean         @default(false)
  mode            PriceWatchMode  @default(INTERVAL)
  intervalMinutes Int             @default(360)
  /// Tehran wall-clock `HH:mm`, meaningful only in DAILY mode. Tehran's offset has changed twice
  /// and is scheduled to change again, so it is never a stored offset and never a stored instant.
  dailyAt         String?
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

/// One check, and what it found.
///
/// A run is a row before it is a result: a check that fetches a live third-party catalogue takes
/// seconds, and "the watch is enabled but nothing has run since Tuesday" is a question the panel
/// has to be able to answer. `error` is why a FAILED run failed, because a failed check that left
/// no trace is indistinguishable from a watch that is switched off.
model PriceWatchRun {
  id         String            @id @default(cuid())
  status     PriceWatchRunStatus
  trigger    PriceWatchTrigger
  /// How many price entries the source returned — the size of the fetched index.
  quotes     Int               @default(0)
  /// How many of our products the index matched.
  matched    Int               @default(0)
  /// How many variants differed. Equal to the number of `PriceChange` rows this run wrote.
  changes    Int               @default(0)
  error      String?
  startedAt  DateTime          @default(now())
  finishedAt DateTime?

  priceChanges PriceChange[]

  @@index([startedAt])
}

/// One variant whose price differs from the source's, recorded for an operator to judge.
///
/// The watch never changes a price: a detected difference is a `PENDING` row, and `Variant.price`
/// moves only when an operator applies one. That is the whole point of the feature — a crawler
/// rewriting the shop's prices unattended would let a bad scrape response reprice a live shop.
/// So the row is the finding, and the apply is a separate, audited decision.
///
/// `sku`, `productName` and `colorName` are denormalised on purpose. The review list is a queue an
/// operator works through, and a row whose text cost three joins to display is a queue that
/// renders slowly and reads "gateway unavailable" instead. The names are copied at detection; a
/// later rename shows the name the finding was made under, which is what a reviewer wants to see.
model PriceChange {
  id          String            @id @default(cuid())
  runId       String
  variantId   String
  productId   String
  sku         String
  productName String
  colorName   String
  fromPrice   Float // TOMAN, as `Variant.price` had it
  toPrice     Float // TOMAN, as the source has it now
  sourceUrl   String
  status      PriceChangeStatus @default(PENDING)
  detectedAt  DateTime          @default(now())
  appliedAt   DateTime?
  appliedById String?
  run         PriceWatchRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// One finding per variant per run. A variant matched twice in one run — a duplicate entry in
  /// the source's own payload, say — would otherwise be two rows claiming the same variant needs
  /// review, and applying both would write the price twice.
  @@unique([runId, variantId])
  /// The index the panel's queue reads: pending first, newest first.
  @@index([status, detectedAt])
}
