{
  "name": "@kmodern/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The one process that talks to the database. Owns the schema, the generated client, the migrations and the data scripts.",
  "exports": {
    "./prisma": "./src/prisma/index.ts",
    "./storage": "./src/storage/storage.ts",
    "./payments": "./src/payments/zarinpal.ts",
    "./sms": "./src/sms/kavenegar.ts",
    "./shipping": "./src/shipping/postex.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "studio": "prisma studio",
    "db:seed": "tsx seed/seed.ts",
    "db:images": "tsx seed/images.ts",
    "db:bootstrap": "tsx seed/bootstrap.ts",
    "db:home-manufacturers": "tsx seed/update-home-manufacturers.ts",
    "db:blog": "tsx seed/blog-import.ts",
    "db:home-deals": "tsx seed/update-home-deals.ts",
    "db:editorial-images": "tsx seed/generate-editorial-images.ts",
    "db:audit-images": "tsx seed/audit-images.ts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/gateway-dist-manifest.mjs",
    "start": "node dist/apps/api/src/main.js",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@kmodern/contracts": "workspace:*",
    "@kmodern/scraper-core": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "dotenv": "^16.4.5",
    "prisma": "^7.10.0",
    "tsx": "^4.19.0"
  }
}
