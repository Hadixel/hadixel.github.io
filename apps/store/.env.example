# Variables the storefront reads. See the repository root .env.example for the full list
# and the tier each variable belongs to.

# Canonical origin, inlined at build. Used by sitemap.ts and robots.ts.
NEXT_PUBLIC_BASE_URL=https://kmodern.ir

# The gateway's base URL, inlined at build. The home page and every CMS page read through it, so a
# build without this value calls http://127.0.0.1:3102 and every read reports a failure.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3102
