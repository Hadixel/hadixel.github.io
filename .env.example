# Every environment variable this repo reads, with the tier it belongs to.
#
# Tier 1 — local secret. Read at runtime by one process. Never committed, never inlined.
# Tier 2 — public. Inlined into the client bundle at build time, so it is part of the
#          build cache key and a change to it must rebuild.
# Tier 3 — CI only. Read by the pipeline.
#
# Copy to .env and fill in. `.env` is gitignored.

# ---------------------------------------------------------------- data tier (tier 1)
# Postgres connection string for the one datastore. Read at runtime by the process that
# owns the database. Must never be available at build time: a secret that reaches a build
# lands in the build output.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# ------------------------------------------------------------- storefront public (tier 2)
# Canonical origin, inlined at build. Used by sitemap.ts and robots.ts.
NEXT_PUBLIC_BASE_URL=https://kmodern.ir

# ------------------------------------------------------------------- media storage (tier 1)
# S3-compatible object storage. Unset means media is served from apps/store/public.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------- payment gateway (tier 1)
# Anything other than "sandbox" is treated as live.
ZARINPAL_MERCHANT_ID=
ZARINPAL_MODE=sandbox

# ------------------------------------------------------------------------- SMS (tier 1)
# Kavenegar lookup API key. Unset disables order SMS.
KAVENEGAR_API_KEY=

# ----------------------------------------------------------------------- shipping (tier 1)
# Postex API key. Unset falls back to the flat shipping fee setting.
POSTEX_API_KEY=

# ------------------------------------------------------------------------- tooling (tier 3)
# One-off scripts only. Never needed by a running app.
#   pnpm db:bootstrap   -> creates the first admin user and forces a password change.
ADMIN_EMAIL=
ADMIN_PASSWORD=
#   pnpm blog:import    -> base timestamp for backdated blog posts.
BLOG_PUBLISH_BASE=
#   pnpm scrape         -> SCRAPE_CACHE=1 enables the on-disk scrape cache.
SCRAPE_CACHE=
#   pnpm --filter @kmodern/db db:editorial-images -> generates the storefront editorial
#   images. One-off; never needed by a running app.
GEMINI_API_KEY=
