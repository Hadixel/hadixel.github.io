{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Kmodern app (Next.js, client + server components)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
